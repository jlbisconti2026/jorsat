apiVersion: v1
kind: ConfigMap
metadata:
  name: n8n-common-config
  namespace: arquitectura
data:
  NODE_EXTRA_CA_CERTS: "/etc/ssl/certs/certnew.crt"
  WEBHOOK_URL: "https://wfia-noprod.claro.amx"
  N8N_EDITOR_BASE_URL: "https://n8neditor-noprod.claro.amx"
  N8N_LOG_LEVEL: "debug"
  N8N_LOG_OUTPUT: "console"
  EXECUTIONS_MODE: "queue"
  OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS: "true"
  N8N_SECURE_COOKIE: "false"
  N8N_COMMUNITY_PACKAGES_ALLOW_TOOL_USAGE: "true"
  N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS: "false"
  NODE_TLS_REJECT_UNAUTHORIZED: "0"
  NODES_EXCLUDE: "[]"
  GENERIC_TIMEZONE: "America/Argentina/Buenos_Aires"
  TZ: "America/Argentina/Buenos_Aires"
  # Redis
  QUEUE_BULL_REDIS_PORT: "6379"
  QUEUE_BULL_REDIS_USERNAME: "default"
  QUEUE_BULL_REDIS_CLUSTER_NODES: "redis-cluster-leader-0.redis-cluster-leader-headless.redis.svc.cluster.local:6379,redis-cluster-leader-1.redis-cluster-leader-headless.redis.svc.cluster.local:6379,redis-cluster-leader-2.redis-cluster-leader-headless.redis.svc.cluster.local:6379,redis-cluster-follower-0.redis-cluster-follower-headless.redis.svc.cluster.local:6379,redis-cluster-follower-1.redis-cluster-follower-headless.redis.svc.cluster.local:6379,redis-cluster-follower-2.redis-cluster-follower-headless.redis.svc.cluster.local:6379"
  # Postgres
  DB_TYPE: "postgresdb"
  DB_TABLE_PREFIX: "n8n"
  DB_POSTGRESDB_DATABASE: "n8n"
  DB_POSTGRESDB_HOST: "postgres-single.arquitectura.svc.cluster.local"
  DB_POSTGRESDB_PORT: "5432"
  # Metrics
  N8N_METRICS: "true"
  N8N_METRICS_INCLUDE_DEFAULT_METRICS: "true"
  N8N_METRICS_INCLUDE_WORKFLOW_ID_LABEL: "true"
  N8N_METRICS_INCLUDE_NODE_TYPE_LABEL: "true"
  N8N_METRICS_INCLUDE_QUEUE_METRICS: "true"
  N8N_METRICS_INCLUDE_API_ENDPOINTS: "true"
  N8N_METRICS_QUEUE_METRICS_INTERVAL: "300"
  N8N_TRUST_PROXY: "true"
  # S3
  #N8N_EXTERNAL_STORAGE_S3_BUCKET_NAME: "n8n-ia-noprod"
  #N8N_EXTERNAL_STORAGE_S3_BUCKET_REGION: "BSAS-ARGENTINA-1"
  #N8N_EXTERNAL_STORAGE_S3_HOST: "10.202.36.116"
  #N8N_DEFAULT_BINARY_DATA_MODE: "s3"
  #N8N_AVAILABLE_BINARY_DATA_MODES: "s3"
  #N8N_DATA_TABLES_MAX_SIZE_BYTES: "1073741824"
---
apiVersion: v1
kind: Secret
metadata:
  name: n8n-common-secrets
  namespace: arquitectura
type: Opaque
stringData:
  N8N_ENCRYPTION_KEY: "n8n"
  QUEUE_BULL_REDIS_PASSWORD: "Li2DUoi3oexUWzmiN+r3QaNDX85wvos"
  DB_POSTGRESDB_USER: "n8n"
  DB_POSTGRESDB_PASSWORD: "3vUZqecAQvh5yfsC0VifFPIYxW9INVUPdrU47J8EDsk="
  N8N_EXTERNAL_STORAGE_S3_ACCESS_KEY: "BDCC0CE302462F054D96"
  N8N_EXTERNAL_STORAGE_S3_ACCESS_SECRET: "9mpxT08V4+Rmx7CjG449uBlklvQAAAGaAkYvBg62"
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: n8n-main-config
  namespace: arquitectura
data:
  N8N_PROCESS: "main"
  N8N_HOST: "n8neditor-noprod.claro.amx"
  N8N_FEATURE_FLAG_MCP: "true"
  N8N_PROXY_HOPS: "1"
  EXECUTIONS_DATA_PRUNE: "true"
  EXECUTIONS_DATA_MAX_AGE: "210"
  EXECUTIONS_DATA_PRUNE_SOFT_DELETE_INTERVAL: "1440"
  EXECUTIONS_DATA_PRUNE_HARD_DELETE_INTERVAL: "1440"
  NODE_OPTIONS: "--max-old-space-size=5632 --max-semi-space-size=64"
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: n8n-worker-config
  namespace: arquitectura
data:
  N8N_PROCESS: "worker"
  N8N_PORT: "5678"
  N8N_METRICS_PREFIX: "n8n_worker_"
  N8N_RUNNERS_ENABLED: "true"
  N8N_RUNNERS_BROKER_LISTEN_ADDRESS: "0.0.0.0"
  N8N_RUNNERS_MODE: "external"
  N8N_REINSTALL_MISSING_PACKAGES: "true"
  NODE_OPTIONS: "--max-old-space-size=4096 --max-semi-space-size=64"
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: n8n-runner-config
  namespace: arquitectura
data:
  N8N_RUNNERS_TASK_BROKER_URI: "http://localhost:5679"
  N8N_RUNNERS_AUTO_SHUTDOWN_TIMEOUT: "0"
  N8N_RUNNERS_MAX_CONCURRENCY: "5"
  NODE_FUNCTION_ALLOW_EXTERNAL: "yaml"
  NODE_OPTIONS: "--max-old-space-size=768"
---
apiVersion: v1
kind: Secret
metadata:
  name: n8n-runner-secrets
  namespace: arquitectura
type: Opaque
stringData:
  N8N_RUNNERS_AUTH_TOKEN: "Opensh1111...qu3?"
